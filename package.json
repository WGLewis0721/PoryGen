{
  "name": "porygen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "vercel-build": "node packages/source-index/hydrate.mjs && npm run build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run && npm --prefix labs/source-search-lab test && npm --prefix packages/source-index test",
    "index:build": "node packages/source-index/cli.mjs build",
    "test:deployment": "node --test scripts/deployment-smoke.mjs",
    "test:ingestion": "node --test scripts/test-zip-ingestion.mjs",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed-lattice.ts"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@porygen/provenance-core": "*",
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "tree-sitter-wasms": "^0.1.13",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "web-tree-sitter": "^0.22.6"
  }
}
