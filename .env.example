# Copy to .env.local for local development. Vite reads .env.local
# automatically; nothing here is a real credential.

# --- Frontend (bundled into the browser build; safe to expose) -------------
# From Supabase project Settings > API. The publishable key is not a secret:
# it is only ever as powerful as the RLS policies in supabase/migrations allow.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Sales contact for Enterprise / Diligence Pack. TODO: client to supply. Leave
# empty to show "a sales contact is being set up".
VITE_SALES_EMAIL=
# Set to "true" only once STRIPE_PRICE_PRO_MONTHLY / STRIPE_PRICE_TEAM_MONTHLY
# are configured server-side; otherwise paid checkout stays closed in the UI.
VITE_BILLING_CHECKOUT_ENABLED=

# --- Server-side only (Supabase Edge Function secrets, never in the bundle) -
# Set these with `supabase secrets set` against the linked project, not here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Customer subscriptions (docs/STRIPE_SETUP.md)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
# APEX dogfood one-time SKU (docs/APEX_DOGFOOD.md). STRIPE_PRO_PRICE_ID is
# still read as a legacy fallback for the same price.
STRIPE_APEX_DOGFOOD_PRICE_ID=
STRIPE_PRO_PRICE_ID=
APEX_CUSTOMER_ID=
GITHUB_TOKEN=
