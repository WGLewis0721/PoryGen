# Copy to .env.local for local development. Vite reads .env.local
# automatically; nothing here is a real credential.

# --- Frontend (bundled into the browser build; safe to expose) -------------
# From Supabase project Settings > API. The publishable/anon key is not a
# secret: it is only ever as powerful as the RLS policies in
# supabase/migrations allow.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Server-side only (Supabase Edge Function secrets, never in the bundle) -
# Set these with `supabase secrets set` against the linked project, not here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
APEX_CUSTOMER_ID=
GITHUB_TOKEN=
